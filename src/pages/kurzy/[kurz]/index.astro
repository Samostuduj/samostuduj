---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StatusBadge from "../../../components/StatusBadge.astro";

export async function getStaticPaths() {
  const entries = await getCollection("kurzy", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { kurz: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const lekce = (await getCollection("lekce", ({ data }) => !data.draft))
  .filter((l) => l.id.startsWith(`${entry.id}/`))
  .sort((a, b) => a.data.order - b.data.order);

const levelLabel: Record<string, string> = {
  "úvod": "Úvod",
  "bakalář": "Bakalář",
  "magistr": "Magistr",
};

const meta = [entry.data.obor, entry.data.level ? levelLabel[entry.data.level] : undefined]
  .filter(Boolean)
  .join(" · ");
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <a href="/kurzy" class="text-sm text-accent hover:underline">← Zpět na kurzy</a>
    <header class="mt-6">
      <h1 class="text-3xl font-bold leading-tight tracking-tight md:text-4xl">
        {entry.data.title}
      </h1>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        {meta && <p class="text-sm text-muted">{meta}</p>}
        <StatusBadge status={entry.data.status} />
      </div>
    </header>
    <div class="prose mt-8">
      <Content />
    </div>

    {lekce.length > 0 && (
      <ol class="mt-10 divide-y divide-border border-y border-border">
        {lekce.map((l, i) => {
          const slug = l.id.slice(entry.id.length + 1);
          return (
            <li class="py-5 first:pt-0 last:pb-0">
              <a href={`/kurzy/${entry.id}/${slug}`} class="group flex items-start gap-4">
                <span class="mt-0.5 shrink-0 font-mono text-sm text-muted">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="min-w-0">
                  <span class="flex flex-wrap items-center gap-2 font-semibold group-hover:text-accent">
                    {l.data.title}
                    <StatusBadge status={l.data.status} />
                  </span>
                  {l.data.summary && <span class="mt-1 block text-sm text-muted">{l.data.summary}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    )}
  </article>
</BaseLayout>
